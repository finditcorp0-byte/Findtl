# Plantilla de variables de entorno.
#
# Copia este archivo a `.env.local` y rellena los valores reales:
#   copy .env.example .env.local   (Windows CMD/PowerShell)
#   cp .env.example .env.local     (Linux/macOS)
#
# `.env.local` está en `.gitignore` y NO debe subirse nunca al repositorio.
# Los valores de este archivo son ficticios: no contienen credenciales reales.

# --- Supabase (se configurará en la fase de integración) ---
# URL del proyecto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Clave pública (anon). Es segura para el navegador solo si RLS está activa.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder
