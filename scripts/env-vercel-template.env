# ============================================================================
# VARIABLES DE ENTORNO PARA VERCEL - FindIt Campus
# ============================================================================
# Configurar estas variables en Vercel Dashboard > Project > Settings > Environment Variables
# Distinguir entre variables públicas (cliente) y secretas (servidor)
# NO exponer claves secretas con prefijo NEXT_PUBLIC_
# ============================================================================

# ----------------------------------------------------------------------------
# Variables públicas (cliente-side) - Seguras para exponir en el navegador
# ----------------------------------------------------------------------------

# URL del proyecto Supabase Cloud
# Ejemplo: https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima (anon key) de Supabase para operaciones desde el cliente
# Obtenerla de: Supabase Dashboard > Settings > API > public anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL base de la aplicación en producción (usada para redirecciones OAuth)
# Ejemplo: https://findit-campus.vercel.app
NEXT_PUBLIC_APP_URL=

# ----------------------------------------------------------------------------
# Variables secretas (servidor-side) - NUNCA exponer en el navegador
# ----------------------------------------------------------------------------

# Service Role Key de Supabase (solo para Server Actions y operaciones admin)
# Obtenerla de: Supabase Dashboard > Settings > API > service_role key
# ⚠️ NUNCA usar NEXT_PUBLIC_ prefijo para esta variable
SUPABASE_SERVICE_ROLE_KEY=

# Secreto para firmar sesiones de autenticación (si se usa auth custom)
# Ejemplo: openssl rand -base64 32
NEXTAUTH_SECRET=

# URL de redirección para callbacks de OAuth (Google, etc.)
# Ejemplo: https://findit-campus.vercel.app/auth/callback
NEXTAUTH_URL=

# ----------------------------------------------------------------------------
# Opcional: Monitoreo y analítica
# ----------------------------------------------------------------------------

# Sentry DSN para rastreo de errores (opcional)
# NEXT_PUBLIC_SENTRY_DSN=

# Vercel Analytics (activar automáticamente en Vercel Dashboard)
# VERCEL_ANALYTICS_ID=

# ============================================================================
# INSTRUCCIONES DE CONFIGURACIÓN EN VERCEL:
# ============================================================================
# 1. Iniciar sesión en https://vercel.com
# 2. Seleccionar el proyecto FindIt Campus
# 3. Ir a Settings > Environment Variables
# 4. Agregar cada variable con su valor correspondiente
# 5. Para NEXT_PUBLIC_*: seleccionar "Production", "Preview", "Development"
# 6. Para SUPABASE_SERVICE_ROLE_KEY: seleccionar solo "Production" (y Preview si es necesario)
# 7. Hacer clic en "Add" y luego redeployar el proyecto
# ============================================================================